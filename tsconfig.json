{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    // "skipLibCheck": true,
    "strict": true,
    // "noUncheckedIndexedAccess": true, // Prevents accessing array[0] without checking if it exists
    // "noImplicitOverride": true, // Forces `override` keyword in classes
    // "exactOptionalPropertyTypes": true, // Stricter handling of optional properties
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/types/**/*.ts"],
  "exclude": ["node_modules", "**/__*/**", "**/**/_*.ts*"]
}
